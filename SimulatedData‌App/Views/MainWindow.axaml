<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:SimulatedDataApp.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        Width="1280" Height="820"
        MinWidth="820" MinHeight="560"
        x:Class="SimulatedDataApp.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="终端设备数据模拟工具"
        FontFamily="Noto Sans SC, Inter, Arial, 'Microsoft YaHei', 'PingFang SC', 'WenQuanYi Zen Hei', sans-serif"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38">

    <Grid RowDefinitions="Auto,*">

        <!-- ========== 自绘标题栏 ========== -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Height="38"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="12,0,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="0">
                <!-- 图标 + 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Image Width="18" Height="18"
                           Source="/Assets/Icon.png"
                           VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Text="终端设备数据模拟工具"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 最小化 -->
                <Button x:Name="MinBtn"
                        Grid.Column="2"
                        Width="46" Height="38"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="—" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- 最大化 / 还原 -->
                <Button x:Name="MaxBtn"
                        Grid.Column="3"
                        Width="46" Height="38"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock x:Name="MaxBtnText"
                               Text="□" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- 关闭 -->
                <Button x:Name="CloseBtn"
                        Grid.Column="4"
                        Width="46" Height="38"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ========== 主内容区 ========== -->
        <views:MainView Grid.Row="1" />

    </Grid>
</Window>